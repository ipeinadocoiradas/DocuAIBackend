{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DocuAI": "Host=localhost;Port=5432;Database=docuai;Username=docuai;Password=configure-en-user-secrets"
  },

  "Database": {
    "ApplyMigrationsOnStartup": false
  },

  "ChatProvider": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "ApiKey": "",
    "Model": "gemini-3.5-flash-lite",
    "DefaultHeaders": {},
    "Resilience": {
      "MaxRetryAttempts": 2,
      "BaseDelay": "00:00:02",
      "MaxDelay": "00:00:15",
      "AttemptTimeout": "00:01:30",
      "TotalTimeout": "00:02:00",
      "CircuitBreakDuration": "00:00:30"
    }
  },

  "Embeddings": {
    "BaseUrl": "http://localhost:11434/v1/",
    "ApiKey": "",
    "Model": "bge-m3",
    "Dimensions": 1024,
    "SendDimensionsParameter": false,
    "HealthCheckEnabled": true,
    "Resilience": {
      "MaxRetryAttempts": 3,
      "BaseDelay": "00:00:01",
      "MaxDelay": "00:00:10",
      "AttemptTimeout": "00:02:00",
      "TotalTimeout": "00:05:00",
      "CircuitBreakDuration": "00:00:30"
    }
  },

  "Ingestion": {
    "ChunkSizeTokens": 500,
    "ChunkOverlapTokens": 100,
    "EmbeddingBatchSize": 32,
    "DelayBetweenBatches": "00:00:00.500",
    "QueueCapacity": 100
  },

  "Chat": {
    "DefaultTopK": 5,
    "MaxTopK": 20,
    "MaxQuestionLength": 2000
  },

  "Agent": {
    "RetrievalMode": "PreRetrieval",
    "MinSimilarity": 0.25,
    "Temperature": 0.1,
    "MaxOutputTokens": 2048,
    "MaxToolIterations": 3
  },

  "RateLimiting": {
    "ChatRequestsPerMinute": 3
  },

  "Cors": {
    "AllowedOrigins": [],
    "AdditionalAllowedHeaders": [],
    "PreflightMaxAge": "00:10:00"
  },

  "Authentication": {
    "Jwt": {
      "Issuer": "https://docuai.local",
      "Audience": "docuai-api",
      "SigningKey": "",
      "AccessTokenLifetime": "01:00:00"
    },
    "DevelopmentUsers": {
      "Enabled": false,
      "Users": []
    }
  }
}
